# Frontend Environment Variables
# Copy to .env.local for local development

# API URL (Railway backend)
# Local: VITE_API_URL=http://localhost:3001/api
# Production: VITE_API_URL=https://your-backend.railway.app/api
VITE_API_URL=

# Disable MFA banner in dev (optional)
# VITE_DISABLE_MFA_IN_DEV=true
